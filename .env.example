# ResearchFlow AI - Environment Variables Template
# ----------------------------------------------------

PORT=3000
NODE_ENV=production

# AI Model Keys (Platform Managed Mode)
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Security
JWT_SECRET=your_production_jwt_secret_key_here

# BYOK Cryptographic Vault Key (32-byte hex for AES-256-GCM encryption of user provider keys)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AI_ENCRYPTION_KEY=your_64_character_hex_encryption_key_here

# Razorpay SaaS Monetization (Standard Checkout & Webhooks)
RAZORPAY_MODE=live
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_your_key_id
